rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }
    function isAdminUser() {                       // you: a document exists in admins/{uid}
      return signedIn() && exists(/databases/$(db)/documents/admins/$(request.auth.uid));
    }
    function isApprovedMember() {                  // approved by you in the Requests page
      return signedIn()
        && exists(/databases/$(db)/documents/members/$(request.auth.uid))
        && get(/databases/$(db)/documents/members/$(request.auth.uid)).data.status == 'approved';
    }
    function cmsIsEditor() {                       // you, or anyone you added in the CMS "Who can edit"
      return isAdminUser()
        || (signedIn() && exists(/databases/$(db)/documents/cms_editors/$(request.auth.uid)));
    }

    // ---------- membership (index.html: login, Requests, ANS Members) ----------
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;                       // add admins from the Firebase console
    }
    match /members/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || cmsIsEditor());     // you + the editors you allow
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      // the owner may re-send a request (never self-approve); only an admin can approve or reject
      allow update: if cmsIsEditor()                       // approve / reject: you and your editors
        || (signedIn() && request.auth.uid == uid
            && resource.data.status != 'approved'
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.status == 'pending');
      allow delete: if isAdminUser();
    }
    match /roster/{uid} {                          // public list of member names for ANS Members
      allow read: if isApprovedMember() || cmsIsEditor();
      allow write: if cmsIsEditor();
    }
    match /profiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isApprovedMember() || cmsIsEditor());
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    match /birthdays/{uid} {
      allow read: if isApprovedMember() || cmsIsEditor();
      allow create, update: if (isApprovedMember() || cmsIsEditor()) && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ---------- your existing rules (unchanged) ----------
    match /fcmTokens/{tokenId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /tips/{tipId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.authorEmail == request.auth.token.email
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 2000
        && request.resource.data.createdAt is timestamp;
      // Only the author can edit (title/body only) or delete their own tip
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'body', 'editedAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 2000
        && request.resource.data.editedAt is timestamp;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /announcements/{id} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /content/{doc} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---------- CMS (new) ----------
    // read: approved members only (guests and people waiting for approval read nothing)
    // write: you (admin) and the editors you grant
    match /cms_editors/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdminUser());
      allow write: if isAdminUser();
    }
    match /cms_categories/{id} {
      allow read: if isApprovedMember() || cmsIsEditor();
      allow write: if cmsIsEditor();
    }
    match /cms_pages/{id} {
      allow read: if (isApprovedMember() && resource.data.status == 'published')
        // a visitor may read ONLY the published, customized versions of the public pages (keep in sync with PUBLIC_KEYS in ans-cms.js)
        || (resource.data.status == 'published'
            && resource.data.get('replaces', null) in ['game', 'game-heroes', 'sanctuary', 'game-resources', 'game-cross', 'server', 'contact'])
        || cmsIsEditor();
      allow write: if cmsIsEditor();
    }
    match /cms_images/{id} {                       // pictures uploaded in the CMS editor (stored here instead of GitHub)
      allow get: if true;   // one picture at a time by its random id (public pages show them to visitors); nobody can list the collection
      allow list: if false;
      allow create: if cmsIsEditor()
        && request.resource.data.data is string
        && request.resource.data.data.size() < 950000;
      allow update: if false;
      allow delete: if cmsIsEditor();
    }
    match /news/{id} {                             // "What's new" on the home page: you and your editors write, members read
      allow read: if isApprovedMember() || cmsIsEditor();
      allow create: if cmsIsEditor()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 1000
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 100
        && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if isAdminUser() || (cmsIsEditor() && resource.data.authorUid == request.auth.uid);
    }
    match /cms_drafts/{id} {                       // drafts: editors only
      allow read, write: if cmsIsEditor();
    }
  }
}
